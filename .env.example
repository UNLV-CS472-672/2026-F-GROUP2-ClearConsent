# Server-only OpenAI configuration. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
# Optional overrides. Defaults: 90000 ms (max 120000) and 16000 tokens (max 32000).
OPENAI_TIMEOUT_MS=
OPENAI_MAX_OUTPUT_TOKENS=

# The paid analysis route remains disabled unless explicitly enabled for an
# approved local smoke test. Use a random local value for the access token.
ENABLE_PAID_ANALYSIS=0
ANALYSIS_ACCESS_TOKEN=
